<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wolfsonian Museum Map</title>

    <style>
        :root {
            --navy: #1b3a6b;
            --navy-deep: #14294d;
            --blue: #2f6fb3;
            --gold: #f3b73b;
            --gold-deep: #e09e1f;
            --sky: #eaf2fb;
            --cream: #f6f1e9;
            --paper: #ffffff;
            --ink: #1f2733;
            --muted: #5c6573;
            --line: #e4e9f0;
            --shadow: 0 12px 34px rgba(20, 41, 77, 0.10);
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            color: var(--ink);
            background:
                radial-gradient(850px 400px at 10% 0%, rgba(243,183,59,0.12), transparent 70%),
                radial-gradient(850px 400px at 90% 0%, rgba(91,155,213,0.13), transparent 70%),
                #faf9f6;
            min-height: 100vh;
        }

        .page {
            display: grid;
            grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
            align-items: start;
            gap: clamp(24px, 4vw, 56px);
            width: min(1440px, 94%);
            margin: 34px auto;
        }

        .map-panel {
            min-width: 0;
            background: var(--paper);
            border: 1px solid var(--line);
            border-radius: 26px;
            padding: 18px;
            box-shadow: var(--shadow);
        }

        .map-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: 0 0 14px;
        }

        .eyebrow {
            color: var(--blue);
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            margin: 0 0 5px;
        }

        .map-heading h2 {
            margin: 0;
            color: var(--navy);
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(1.4rem, 2.5vw, 2rem);
            font-weight: normal;
        }

        .floor-pill {
            flex: none;
            border-radius: 999px;
            background: var(--sky);
            color: var(--navy);
            border: 1px solid #d6e4f4;
            padding: 7px 12px;
            font-size: 0.88rem;
            font-weight: 700;
        }

        .map-stage {
            position: relative;
            width: 100%;
            overflow: hidden;
            border-radius: 18px;
            background: #f1f1f3;
            border: 1px solid var(--line);
        }

        .map-image {
            display: block;
            width: 100%;
            height: auto;
        }

        /* Covers the original printed floor title and shows the selected floor. */
        .map-floor-label {
            position: absolute;
            top: 2.3%;
            left: 50%;
            transform: translateX(-50%);
            min-width: 100px;
            padding: 3px 8px;
            border-radius: 5px;
            background: rgba(241, 241, 243, 0.96);
            color: #555b64;
            text-align: center;
            font-size: clamp(10px, 1.3vw, 15px);
            font-weight: 700;
            z-index: 2;
            pointer-events: none;
        }

        .location-marker {
            position: absolute;
            z-index: 5;
            width: 25px;
            height: 25px;
            padding: 0;
            transform: translate(-50%, -50%);
            border-radius: 50%;
            border: 3px solid #d6a900;
            background: #ffdf36;
            box-shadow: 0 0 0 6px rgba(255, 215, 0, 0.28),
                        0 0 0 0 rgba(255, 215, 0, 0.65);
            animation: pingAnimation 1.5s infinite;
            pointer-events: none;
        }

        @keyframes pingAnimation {
            0% { box-shadow: 0 0 0 5px rgba(255, 215, 0, 0.32), 0 0 0 0 rgba(255, 215, 0, 0.65); }
            70% { box-shadow: 0 0 0 7px rgba(255, 215, 0, 0.18), 0 0 0 18px rgba(255, 215, 0, 0); }
            100% { box-shadow: 0 0 0 5px rgba(255, 215, 0, 0.12), 0 0 0 0 rgba(255, 215, 0, 0); }
        }

        .floor-two-placeholder {
            display: none;
            aspect-ratio: 561 / 742;
            width: 100%;
            min-height: 360px;
            padding: 30px;
            align-items: center;
            justify-content: center;
            text-align: center;
            background:
                linear-gradient(90deg, transparent 49.5%, rgba(47,111,179,.08) 50%, transparent 50.5%),
                linear-gradient(0deg, transparent 49.5%, rgba(47,111,179,.08) 50%, transparent 50.5%),
                #f1f1f3;
        }

        .placeholder-card {
            max-width: 300px;
            padding: 28px 24px;
            background: rgba(255,255,255,.92);
            border: 1px solid var(--line);
            border-radius: 20px;
            box-shadow: var(--shadow);
        }

        .placeholder-card .placeholder-icon {
            display: grid;
            place-items: center;
            width: 54px;
            height: 54px;
            margin: 0 auto 14px;
            border-radius: 17px;
            background: rgba(243,183,59,.22);
            color: var(--navy);
            font-size: 1.7rem;
        }

        .placeholder-card h3 {
            margin: 0 0 8px;
            color: var(--navy);
            font-family: Georgia, "Times New Roman", serif;
            font-size: 1.4rem;
            font-weight: normal;
        }

        .placeholder-card p {
            margin: 0;
            color: var(--muted);
            font-size: .95rem;
            line-height: 1.55;
        }

        .map-caption {
            color: var(--muted);
            font-size: 0.9rem;
            margin: 12px 2px 0;
            line-height: 1.5;
        }

        .controls {
            min-width: 0;
        }

        .controls h1 {
            margin: 5px 0 12px;
            color: var(--navy);
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(2.6rem, 5vw, 4.4rem);
            font-weight: normal;
            line-height: 1.03;
        }

        .intro {
            color: var(--muted);
            margin: 0 0 22px;
            line-height: 1.55;
        }

        .selection-heading {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 10px;
            margin: 0 0 10px;
        }

        .selection-heading h2 {
            color: var(--navy);
            margin: 0;
            font-size: 1.1rem;
        }

        .selection-count {
            color: var(--muted);
            font-size: .85rem;
        }

        .location-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-height: min(65vh, 590px);
            overflow-y: auto;
            padding: 4px 8px 4px 4px;
            scrollbar-color: #b7c8dd #edf2f8;
            scrollbar-width: thin;
        }

        .location-button {
            display: grid;
            grid-template-columns: 36px minmax(0, 1fr) 18px;
            align-items: center;
            gap: 12px;
            width: 100%;
            min-height: 68px;
            padding: 13px 15px;
            text-align: left;
            background: var(--paper);
            color: var(--navy);
            border: 1px solid var(--line);
            border-left: 5px solid var(--gold);
            border-radius: 15px;
            box-shadow: 0 6px 18px rgba(20, 41, 77, 0.06);
            font-family: inherit;
            font-size: 0.98rem;
            line-height: 1.35;
            cursor: pointer;
            transition: background-color .2s ease, transform .2s ease, box-shadow .2s ease;
        }

        .location-button:hover {
            background: var(--sky);
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(47, 111, 179, 0.13);
        }

        .location-button[aria-pressed="true"] {
            background: #eaf2fb;
            border-color: #b9d2ed;
            border-left-color: var(--gold-deep);
            box-shadow: 0 0 0 2px rgba(47, 111, 179, 0.10);
        }

        .location-number {
            display: grid;
            place-items: center;
            width: 34px;
            height: 34px;
            border-radius: 11px;
            background: var(--sky);
            color: var(--navy);
            font-weight: 700;
        }

        .location-button[aria-pressed="true"] .location-number {
            background: var(--gold);
            color: var(--navy-deep);
        }

        .chevron {
            color: var(--blue);
            font-size: 1.5rem;
            line-height: 1;
            text-align: center;
        }

        .selection-status {
            margin: 14px 0 0;
            padding: 13px 15px;
            border: 1px solid var(--line);
            border-radius: 14px;
            background: rgba(255,255,255,.8);
            color: var(--muted);
            font-size: .9rem;
            line-height: 1.5;
        }

        .selection-status strong { color: var(--navy); }

        @media (max-width: 850px) {
            .page {
                grid-template-columns: 1fr;
                width: min(650px, 94%);
                gap: 28px;
                margin: 20px auto 34px;
            }

            .controls { grid-row: 1; }
            .controls h1 { font-size: clamp(2.6rem, 10vw, 3.7rem); }
            .location-list { max-height: 360px; }
            .map-panel { grid-row: 2; }
            .map-floor-label { font-size: 12px; }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: .01ms !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>

<body>
    <main class="page">
        <section class="map-panel" aria-label="Museum floor map">
            <div class="map-heading">
                <div>
                    <p class="eyebrow">Visitor map</p>
                    <h2 id="mapTitle">Select an exhibit</h2>
                </div>
                <span class="floor-pill" id="floorPill">Choose a location</span>
            </div>

            <div class="map-stage" id="mapStage">
                <img id="mapImage" class="map-image" src="maps/floor-1.png"
                     alt="Wolfsonian museum first floor map">
                <div id="mapFloorLabel" class="map-floor-label">1st Floor</div>
                <div id="locationMarker" class="location-marker"
                     role="img" aria-label="Selected exhibit location"
                     hidden></div>
            </div>

            <div class="floor-two-placeholder" id="floorTwoPlaceholder">
                <div class="placeholder-card">
                    <div class="placeholder-icon" aria-hidden="true">⌖</div>
                    <h3>2nd Floor</h3>
                    <p>No exhibit points are assigned to this floor. Add the second-floor map image later if you want it displayed here.</p>
                </div>
            </div>

            <p class="map-caption" id="mapCaption">
                Choose an exhibit from the list to display its floor and highlight its numbered point.
            </p>
        </section>

        <section class="controls" aria-label="Exhibit selection">
            <p class="eyebrow">The Wolfsonian–FIU</p>
            <h1>Explore the<br>museum</h1>
            <p class="intro">
                Select one of the locations below. The map will switch to that floor
                and highlight the corresponding point in yellow.
            </p>

            <div class="selection-heading">
                <h2>Exhibits and locations</h2>
                <span class="selection-count">18 locations</span>
            </div>

            <div class="location-list" id="locationList" aria-label="Scrollable list of 18 locations">
                <!-- Buttons are created from the location list in JavaScript. -->
            </div>

            <p class="selection-status" id="selectionStatus" aria-live="polite">
                <strong>No location selected.</strong> Choose an item to get started.
            </p>
        </section>
    </main>

    <script>
        /*
         * Map coordinate positions are percentages of each original map image.
         * The 4th-floor map reuses the 3rd-floor layout as requested.
         * The 2nd floor has no exhibit points and currently uses a placeholder.
         */
        const locations = [
            { id: 1,  name: "Library Shelving System", floor: 1, map: "maps/floor-1.png", x: 24.1, y: 68.9 },
            { id: 2,  name: "Bridge Tender House (Josephine Baker Pavilion)", floor: 1, map: "maps/floor-1.png", x: 30.5, y: 73.5 },
            { id: 3,  name: "Web of Life Floor", floor: 1, map: "maps/floor-1.png", x: 36.9, y: 69.1 },
            { id: 4,  name: "Edison Bipolar Dynamo", floor: 1, map: "maps/floor-1.png", x: 50.4, y: 68.5 },
            { id: 5,  name: "Workman’s Heel Print", floor: 1, map: "maps/floor-1.png", x: 62.4, y: 66.4 },
            { id: 6,  name: "Window Frames", floor: 1, map: "maps/floor-1.png", x: 73.8, y: 53.2 },
            { id: 7,  name: "Mailbox", floor: 1, map: "maps/floor-1.png", x: 66.8, y: 48.7 },

            { id: 8,  name: "Material Matters: How Synthetics Shaped a New Era", floor: 3, map: "maps/floor-3.png", x: 23.4, y: 57.9 },
            { id: 9,  name: "Highlights from The Wolfsonian Library", floor: 3, map: "maps/floor-3.png", x: 47.6, y: 58.8 },

            { id: 10, name: "In Small Things Remembered: Medallions, Poster Stamps, and Other Collectibles", floor: 4, map: "maps/floor-3.png", x: 23.4, y: 57.9 },
            { id: 11, name: "Paris Expo 1925", floor: 4, map: "maps/floor-3.png", x: 47.6, y: 58.8 },

            { id: 12, name: "Harry Clarke and the Geneva Window", floor: 5, map: "maps/floor-5.png", x: 49.0, y: 43.1 },
            { id: 13, name: "Brooch", floor: 5, map: "maps/floor-5.png", x: 56.4, y: 52.5 },
            { id: 14, name: "Inkstand and box", floor: 5, map: "maps/floor-5.png", x: 64.1, y: 52.9 },
            { id: 15, name: "Prologue: Who Is Harry Clarke?", floor: 5, map: "maps/floor-5.png", x: 64.1, y: 48.1 },
            { id: 16, name: "Intro: The Geneva Window", floor: 5, map: "maps/floor-5.png", x: 63.0, y: 44.3 },

            { id: 17, name: "Staircase", floor: 6, map: "maps/floor-6.png", x: 72.5, y: 48.4 },
            { id: 18, name: "Ceiling and Chandeliers", floor: 7, map: "maps/floor-7.png", x: 49.5, y: 59.4 }
        ];

        const list = document.getElementById("locationList");
        const mapImage = document.getElementById("mapImage");
        const mapStage = document.getElementById("mapStage");
        const mapFloorLabel = document.getElementById("mapFloorLabel");
        const marker = document.getElementById("locationMarker");
        const mapTitle = document.getElementById("mapTitle");
        const floorPill = document.getElementById("floorPill");
        const mapCaption = document.getElementById("mapCaption");
        const selectionStatus = document.getElementById("selectionStatus");
        const floorTwoPlaceholder = document.getElementById("floorTwoPlaceholder");

        let activeButton = null;

        function floorName(floor) {
            const suffix = floor === 1 ? "st" : floor === 2 ? "nd" : floor === 3 ? "rd" : "th";
            return floor + suffix + " Floor";
        }

        function buildLocationButtons() {
            locations.forEach((location) => {
                const button = document.createElement("button");
                button.type = "button";
                button.className = "location-button";
                button.setAttribute("aria-pressed", "false");
                button.innerHTML = `
                    <span class="location-number">${location.id}</span>
                    <span>${location.name}</span>
                    <span class="chevron" aria-hidden="true">›</span>
                `;
                button.addEventListener("click", () => selectLocation(location, button));
                list.appendChild(button);
            });
        }

        function selectLocation(location, button) {
            if (activeButton) {
                activeButton.setAttribute("aria-pressed", "false");
            }

            activeButton = button;
            activeButton.setAttribute("aria-pressed", "true");

            mapTitle.textContent = location.name;
            floorPill.textContent = floorName(location.floor);
            mapFloorLabel.textContent = floorName(location.floor);
            mapCaption.textContent = `Location ${location.id}: ${location.name}. The yellow circle marks this point on the ${floorName(location.floor).toLowerCase()} map.`;

            if (location.floor === 2) {
                mapStage.style.display = "none";
                floorTwoPlaceholder.style.display = "flex";
                marker.hidden = true;
            } else {
                floorTwoPlaceholder.style.display = "none";
                mapStage.style.display = "block";
                marker.hidden = false;

                const newSource = location.map;
                if (mapImage.getAttribute("src") !== newSource) {
                    mapImage.setAttribute("src", newSource);
                }

                mapImage.alt = `Wolfsonian museum ${floorName(location.floor).toLowerCase()} map`;
                marker.style.left = location.x + "%";
                marker.style.top = location.y + "%";

                /*
                 * If a map image fails to load, show a useful message instead
                 * of silently leaving a broken image.
                 */
                mapImage.onerror = () => {
                    mapCaption.textContent = `Could not load ${newSource}. Make sure the maps folder is next to this HTML file and contains the expected image.`;
                    marker.hidden = true;
                };
                mapImage.onload = () => {
                    marker.hidden = false;
                };
            }

            selectionStatus.innerHTML =
                `<strong>Selected: ${location.name}</strong><br>` +
                `${floorName(location.floor)} · Point ${location.id}`;
        }

        buildLocationButtons();
    </script>
</body>
</html>
