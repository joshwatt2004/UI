```html
<!DOCTYPE html>
<html>
<head>
    <title>Wolfsonian Museum Map</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #faf9f6;
        }

        .page {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 90%;
            margin: 30px auto;
        }

        /* LEFT SIDE - MAP */
        .map-container {
            position: relative;
            width: 55%;
            padding: 12px;
            background-color: #ffffff;
            border: 1px solid #e4e9f0;
            border-radius: 26px;
            box-shadow: 0 12px 34px rgba(20, 41, 77, 0.10);
            box-sizing: border-box;
        }

        .map {
            width: 100%;
            display: block;
            border-radius: 18px;
        }

        /* GOLD ACCENT ON MAP */
        .map-container::before {
            content: "";
            position: absolute;
            top: 12px;
            left: 12px;
            width: 6px;
            height: 55px;
            background-color: #f3b73b;
            border-radius: 0 0 5px 0;
            z-index: 1;
        }

        /* RIGHT SIDE */
        .controls {
            width: 35%;
            text-align: center;
        }

        .controls h1 {
            font-family: Georgia, serif;
            color: #1b3a6b;
            font-size: 55px;
            font-weight: normal;
            line-height: 1.1;
            margin-bottom: 70px;
        }

        /* GRAY BUTTONS */
        .location-button {
            display: block;
            width: 100%;
            min-height: 85px;
            margin-bottom: 20px;
            padding: 15px;

            background-color: #ffffff;
            color: #1b3a6b;
            border: 1px solid #e4e9f0;
            border-left: 5px solid #f3b73b;
            border-radius: 15px;
            box-shadow: 0 8px 24px rgba(20, 41, 77, 0.08);

            font-size: 22px;
            font-family: Arial, sans-serif;
            cursor: pointer;

            transition: background-color 0.2s ease,
                        transform 0.2s ease,
                        box-shadow 0.2s ease;
        }

        .location-button:hover {
            background-color: #eaf2fb;
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(47, 111, 179, 0.15);
        }

        .location-button:active {
            transform: translateY(0);
        }

        /* YELLOW PING - FUNCTIONALITY UNCHANGED */
        .ping {
            position: absolute;

            width: 25px;
            height: 25px;

            background-color: yellow;
            border: 3px solid #d6a900;

            border-radius: 50%;

            transform: translate(-50%, -50%);

            display: none;

            box-shadow: 0 0 0 0 rgba(255, 215, 0, 0.7);

            animation: pingAnimation 1.5s infinite;
        }

        @keyframes pingAnimation {
            0% {
                box-shadow: 0 0 0 0 rgba(255, 215, 0, 0.7);
            }

            70% {
                box-shadow: 0 0 0 18px rgba(255, 215, 0, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(255, 215, 0, 0);
            }
        }

        /* RESPONSIVE LAYOUT */
        @media (max-width: 800px) {
            .page {
                flex-direction: column;
                gap: 35px;
                width: 92%;
            }

            .map-container {
                width: 100%;
            }

            .controls {
                width: 100%;
            }

            .controls h1 {
                font-size: 42px;
                margin-bottom: 30px;
            }

            .location-button {
                min-height: 70px;
                font-size: 18px;
            }
        }
    </style>
</head>

<body>

    <div class="page">

        <!-- MAP -->
        <div class="map-container">

            <img
                src="museum-map.png"
                class="map"
                alt="Wolfsonian museum map"
            >

            <!-- Yellow ping -->
            <div id="ping" class="ping"></div>

        </div>

        <!-- BUTTONS -->
        <div class="controls">

            <h1>
                Explore the<br>
                museum
            </h1>

            <button
                class="location-button"
                onclick="showLocation('deco')">
                The Deco Function Room
            </button>

            <button
                class="location-button"
                onclick="showLocation('american')">
                Early 20th-Century American
            </button>

            <button
                class="location-button"
                onclick="showLocation('starr')">
                Starr Gallery
            </button>

        </div>

    </div>

    <script>

        function showLocation(location) {

            const ping = document.getElementById("ping");

            ping.style.display = "block";

            if (location === "deco") {

                /*
                The Deco Function Room
                */
                ping.style.left = "18%";
                ping.style.top = "53%";

            }

            else if (location === "american") {

                /*
                Early 20th-Century American
                */
                ping.style.left = "35%";
                ping.style.top = "18%";

            }

            else if (location === "starr") {

                /*
                Starr Gallery
                */
                ping.style.left = "75%";
                ping.style.top = "68%";

            }
        }

    </script>

</body>
</html>
